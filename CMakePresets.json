{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 3,
        "patch": 3
    },
    "configurePresets": [
        {
            "name": "base-gcc",
            "hidden": true,
            "description": "A preset with Ninja and GCC",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "test-base-gcc",
            "hidden": true,
            "inherits": "base-gcc",
            "description": "A preset with Ninja and GCC for testing",
            "cacheVariables": {
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "debug-gcc",
            "displayName": "Debug (GCC & Ninja)",
            "inherits": "base-gcc",
            "description": "A debug preset with Ninja and GCC",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-gcc",
            "displayName": "Release (GCC & Ninja)",
            "inherits": "base-gcc",
            "description": "A release preset with Ninja and GCC",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "test-debug-gcc-16-1",
            "displayName": "Test Debug (GCC & Ninja)",
            "inherits": "test-base-gcc",
            "description": "A debug preset with Ninja and GCC for testing",
            "binaryDir": "${sourceDir}/build/test-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "test-release-gcc-16-1",
            "displayName": "Test Release (GCC & Ninja)",
            "inherits": "test-base-gcc",
            "description": "A release preset with Ninja and GCC for testing",
            "binaryDir": "${sourceDir}/build/test-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-debug",
            "displayName": "Build Debug",
            "configurePreset": "debug-gcc"
        },
        {
            "name": "build-release",
            "displayName": "Build Release",
            "configurePreset": "release-gcc"
        },
        {
            "name": "build-test-debug",
            "displayName": "Build Test Debug",
            "configurePreset": "test-debug-gcc-16-1"
        },
        {
            "name": "build-test-release",
            "displayName": "Build Test Release",
            "configurePreset": "test-release-gcc-16-1"
        }
    ]
}