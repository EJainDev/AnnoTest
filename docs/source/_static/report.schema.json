{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnnoTest report schema v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tests": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "time": {
            "type": "number",
            "minimum": 0
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "skipped"
                  ]
                },
                "time": {
                  "type": "number",
                  "minimum": 0
                },
                "stdout": {
                  "type": "string"
                },
                "stderr": {
                  "type": "string"
                },
                "parameters": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "failures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      },
                      "phase": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "diagnostic": {
                        "type": "string"
                      },
                      "location": {
                        "oneOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "file": {
                                "type": "string"
                              },
                              "line": {
                                "type": "integer",
                                "minimum": 0
                              }
                            },
                            "required": [
                              "file",
                              "line"
                            ]
                          }
                        ]
                      }
                    },
                    "required": [
                      "message",
                      "phase",
                      "type",
                      "diagnostic",
                      "location"
                    ]
                  }
                },
                "skip_reason": {
                  "type": "string"
                },
                "properties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "file",
                "line",
                "status",
                "time",
                "stdout",
                "stderr",
                "parameters",
                "tags",
                "failures",
                "skip_reason",
                "properties"
              ]
            }
          }
        },
        "required": [
          "name",
          "file",
          "time",
          "tests"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "tests",
    "failed",
    "skipped",
    "suites"
  ]
}
