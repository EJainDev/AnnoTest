cmake_minimum_required(VERSION 4.3.3)

# Generate a complete manifest only after successful, well-formed discovery.
foreach(required IN ITEMS TEST_EXECUTABLE OUTPUT_FILE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "AnnoTest discovery requires ${required}")
  endif()
endforeach()
# A previous successful manifest must not hide a failed rebuild.
file(REMOVE "${OUTPUT_FILE}" "${OUTPUT_FILE}.tmp")
if(NOT EXISTS "${TEST_EXECUTABLE}" OR IS_DIRECTORY "${TEST_EXECUTABLE}")
  message(FATAL_ERROR "AnnoTest discovery executable is missing: ${TEST_EXECUTABLE}")
endif()
if(NOT DEFINED DISCOVERY_TIMEOUT)
  set(DISCOVERY_TIMEOUT 30)
endif()
if(NOT DISCOVERY_TIMEOUT MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "DISCOVERY_TIMEOUT must be a positive integer in seconds")
endif()
execute_process(
  COMMAND "${TEST_EXECUTABLE}" --list
  OUTPUT_VARIABLE test_output ERROR_VARIABLE test_error
  RESULT_VARIABLE result TIMEOUT "${DISCOVERY_TIMEOUT}")
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR
    "AnnoTest discovery failed for ${TEST_EXECUTABLE} (${result})\nstdout:\n${test_output}\nstderr:\n${test_error}")
endif()

# Bracket arguments preserve quotes, semicolons, backslashes and dollar signs.
function(bracket_quote value output)
  set(equal "=")
  string(LENGTH "${value}" length)
  while(TRUE)
    string(FIND "${value}]${equal}]" "]${equal}]" closing)
    if(closing EQUAL length)
      break()
    endif()
    string(APPEND equal "=")
  endwhile()
  set(${output} "[${equal}[${value}]${equal}]" PARENT_SCOPE)
endfunction()
bracket_quote("${TEST_EXECUTABLE}" executable)
set(manifest "# Generated by AnnoTest discovery\n")
set(current_suite "")
set(count 0)
string(REPLACE "\r\n" "\n" pending "${test_output}")
# Parse individual lines without turning semicolons in names into list separators.
while(NOT pending STREQUAL "")
  string(FIND "${pending}" "\n" newline)
  if(newline EQUAL -1)
    set(line "${pending}")
    set(pending "")
  else()
    string(SUBSTRING "${pending}" 0 ${newline} line)
    math(EXPR next "${newline} + 1")
    string(SUBSTRING "${pending}" ${next} -1 pending)
  endif()
  if(line STREQUAL "")
    continue()
  endif()
  if(line MATCHES "\r")
    message(FATAL_ERROR "Malformed AnnoTest discovery line: ${line}")
  endif()
  if(line MATCHES "^\t")
    string(SUBSTRING "${line}" 1 -1 name)
    if(current_suite STREQUAL "" OR name STREQUAL "" OR name MATCHES "\t")
      message(FATAL_ERROR "Malformed AnnoTest test listing: ${line}")
    endif()
    set(full_name "${current_suite}.${name}")
    string(SHA256 identity "${full_name}")
    if(DEFINED seen_${identity})
      message(FATAL_ERROR "Duplicate AnnoTest discovered test: ${full_name}")
    endif()
    set(seen_${identity} TRUE)
    bracket_quote("${full_name}" quoted_name)
    string(APPEND manifest "add_test(${quoted_name} ${executable} --test-name ${quoted_name})\n")
    math(EXPR count "${count} + 1")
  elseif(line MATCHES "^.+\\.$" AND NOT line MATCHES "\t")
    string(LENGTH "${line}" length)
    math(EXPR length "${length} - 1")
    string(SUBSTRING "${line}" 0 ${length} current_suite)
  else()
    message(FATAL_ERROR "Malformed AnnoTest discovery output: ${line}")
  endif()
endwhile()
if(count EQUAL 0)
  message(FATAL_ERROR "AnnoTest discovery found no tests in ${TEST_EXECUTABLE}")
endif()
file(WRITE "${OUTPUT_FILE}.tmp" "${manifest}")
file(RENAME "${OUTPUT_FILE}.tmp" "${OUTPUT_FILE}")
message(STATUS "AnnoTest discovered ${count} tests in ${TEST_EXECUTABLE}")
